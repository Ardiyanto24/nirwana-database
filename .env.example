# Koneksi langsung Postgres Supabase (dipakai oleh psycopg2 untuk COPY & insert massal)
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
SUPABASE_DB_URL=

# Opsional (belum dipakai di v1, disiapkan untuk kebutuhan lewat REST/PostgREST)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Grafana Cloud (Milestone 1.5 -- dashboard & alerting)
# Format URL: https://<nama-instance>.grafana.net
# Token: Grafana Cloud > Administration > Users and access > Service accounts > Add service account token
GRAFANA_URL=
GRAFANA_SERVICE_ACCOUNT_TOKEN=

# Milestone 2.1 -- role read-only untuk ekstraksi production -> raw_production.
# Ditulis otomatis oleh scripts/extract/setup_extract_role.py, jangan diisi manual.
EXTRACT_DB_URL=

# Milestone 2.1 -- BigQuery (project nirwana-database-elt, BigQuery Sandbox mode)
# Key file service account dibuat manual (lihat milestones/2.1-.../decisions.md),
# path relatif ke repo root.
GOOGLE_APPLICATION_CREDENTIALS=scripts/extract/gcp-extract-writer-key.json
BIGQUERY_PROJECT_ID=nirwana-database-elt
BIGQUERY_DATASET=raw_production

# Milestone 2.3 -- service account dbt-transform (project-level bigquery.dataEditor,
# beda dari extract-writer di atas yang scoped ke raw_production saja). Dipakai
# scripts/mart_cleaned/promote.py untuk akses mart_cleaned_staging/mart_cleaned.
DBT_TRANSFORM_CREDENTIALS=scripts/extract/gcp-dbt-transform-key.json

# Milestone 2.4 -- koneksi ADMIN ke project Supabase BARU khusus serving layer
# (terpisah dari SUPABASE_DB_URL di atas, yang tetap untuk production). Dipakai
# HANYA oleh script setup satu kali (setup_serving_schema.py, setup_writer_role.py)
# -- sync.py sehari-hari pakai REVERSE_ETL_WRITER_DB_URL (least-privilege) di bawah.
# PAKAI SESSION POOLER, bukan direct connection -- project Supabase baru
# defaultnya direct-connection IPv6-only, tidak reachable dari environment
# ini (dikonfirmasi lewat nslookup saat Task 1, lihat logs.md). Session
# pooler (bukan Transaction) tetap dedicated per koneksi, cukup stabil untuk
# psycopg2.copy_expert bulk load tabel besar (mis. fnb_transactions ~902k baris).
# Ambil dari Project Settings > Database > Connection string > toggle "Use
# connection pooling" > mode Session.
# Format: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
SERVING_DB_URL=

# Milestone 2.4 -- role least-privilege reverse_etl_writer (scoped ke schema
# mart_cleaned saja di serving project, bukan superuser). Ditulis otomatis
# oleh scripts/reverse_etl/setup_writer_role.py, jangan diisi manual.
REVERSE_ETL_WRITER_DB_URL=

# Milestone 2.4 -- service account reverse-etl-reader (read-only, dataset-scoped
# ke mart_cleaned SAJA di BigQuery -- beda dari dbt-transform di atas yang
# project-level). Dipakai scripts/reverse_etl/sync.py untuk baca sumber data.
REVERSE_ETL_READER_CREDENTIALS=scripts/extract/gcp-reverse-etl-reader-key.json

# Milestone 2.5 -- service account data-scientist-reader (read-only, dataset-scoped
# ke mart_cleaned SAJA di BigQuery -- kredensial terpisah dari reverse-etl-reader
# di atas, meski sama-sama scoped ke mart_cleaned, supaya rotasi/pencabutan akses
# salah satu tidak memengaruhi yang lain). Dipakai
# scripts/data_scientist_access/example_query.py.
DATA_SCIENTIST_READER_CREDENTIALS=scripts/extract/gcp-data-scientist-reader-key.json

# Milestone 5.4 -- service account ml-scoring-writer (write-only, dataset-scoped
# ke ml_output SAJA di BigQuery -- pola sama extract-writer, dipakai proses yang
# menulis dari "luar" warehouse ke 1 dataset spesifik). Dipakai
# scripts/ml_scoring/mock_score.py. CATATAN: ml_output di milestone ini murni
# simulasi/contoh (lihat milestones/5.4-.../decisions.md) -- bukan skema final
# dari tim ML Engineer sungguhan.
ML_SCORING_WRITER_CREDENTIALS=scripts/extract/gcp-ml-scoring-writer-key.json

# Milestone 5.5 -- service account reverse-etl-mart-agg-reader (read-only,
# dataset-scoped ke mart_aggregated SAJA di BigQuery -- kredensial terpisah
# dari reverse-etl-reader M2.4 (scoped mart_cleaned), meski nama & perannya
# analog. Dipakai scripts/reverse_etl_mart_aggregated/sync.py.
REVERSE_ETL_MART_AGGREGATED_READER_CREDENTIALS=scripts/extract/gcp-reverse-etl-mart-agg-reader-key.json

# Milestone 5.5 -- role least-privilege reverse_etl_mart_aggregated_writer
# (scoped ke schema mart_aggregated saja di serving project M2.4, bukan
# superuser -- kredensial terpisah dari reverse_etl_writer M2.4/mart_cleaned).
# Ditulis otomatis oleh scripts/reverse_etl_mart_aggregated/setup_writer_role.py,
# jangan diisi manual.
REVERSE_ETL_MART_AGGREGATED_WRITER_DB_URL=

# Milestone 3.5 -- 7 role read-only Data Analyst di serving project (6 role
# domain + 1 role union Property/GM), GRANT SELECT scoped ke view analyst_views/
# tabel mart_cleaned per domain saja (lihat docs/08-serving-data-analyst/
# kredensial-analyst.md) -- ini kredensial pertama di project ini yang benar-benar
# diserahkan ke konsumen Data Analyst (bukan proses internal/scheduled job).
# Ditulis otomatis oleh scripts/data_analyst_credentials/setup_analyst_roles.py,
# jangan diisi manual.
REVENUE_ANALYST_READER_DB_URL=
FNB_ANALYST_READER_DB_URL=
FACILITY_ANALYST_READER_DB_URL=
SPA_EVENT_ANALYST_READER_DB_URL=
HR_ANALYST_READER_DB_URL=
CORPORATE_FINANCIAL_ANALYST_READER_DB_URL=
PROPERTY_GM_ANALYST_READER_DB_URL=

# Milestone 3.6 -- service account analyst-readonly (read-only, dataset-scoped
# ke mart_cleaned DAN mart_aggregated -- 2 dataset ACL, beda dari kredensial
# BigQuery lain yang cuma 1 dataset. Dipakai tim Data Analyst untuk akses
# BigQuery langsung via BI tool (lihat docs/08-serving-data-analyst/bi-tool-analyst.md).
ANALYST_READONLY_CREDENTIALS=scripts/extract/gcp-analyst-readonly-key.json

# Milestone 4.3 -- 10 role Postgres AI Chatbot (1 per data_domain), GRANT
# SELECT hanya ke view schema chatbot_views (M4.2) -- TIDAK PERNAH ke tabel
# mart_aggregated/mart_cleaned langsung (lebih ketat dari kredensial Data
# Analyst, lihat docs/09-serving-ai-chatbot/kredensial-chatbot.md).
# Ditulis otomatis oleh scripts/chatbot_credentials/setup_chatbot_roles.py,
# jangan diisi manual.
RESERVATION_CHATBOT_READER_DB_URL=
FNB_CHATBOT_READER_DB_URL=
FACILITY_CHATBOT_READER_DB_URL=
SPA_EVENT_CHATBOT_READER_DB_URL=
HR_CHATBOT_READER_DB_URL=
FINANCIAL_CHATBOT_READER_DB_URL=
PROPERTIES_REF_CHATBOT_READER_DB_URL=
EMPLOYEES_DIRECTORY_CHATBOT_READER_DB_URL=
GUESTS_PII_CHATBOT_READER_DB_URL=
GUESTS_PROFILE_CHATBOT_READER_DB_URL=

# Milestone 4.4 -- chatbot_authz_reader, SELECT-only ke mart_cleaned.role_permissions
# SAJA. Dipakai murni internal oleh scripts/chatbot_api/ untuk keputusan otorisasi
# per request -- hasil query tabel ini tidak pernah diteruskan sebagai response
# endpoint API manapun (lihat docs/09-serving-ai-chatbot/api-chatbot.md).
CHATBOT_AUTHZ_READER_DB_URL=
