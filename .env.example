# Koneksi langsung Postgres Supabase (dipakai oleh psycopg2 untuk COPY & insert massal)
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
SUPABASE_DB_URL=

# Opsional (belum dipakai di v1, disiapkan untuk kebutuhan lewat REST/PostgREST)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Grafana Cloud (Milestone 1.5 -- dashboard & alerting)
# Format URL: https://<nama-instance>.grafana.net
# Token: Grafana Cloud > Administration > Users and access > Service accounts > Add service account token
GRAFANA_URL=
GRAFANA_SERVICE_ACCOUNT_TOKEN=
